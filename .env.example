# =============================================================================
# Lakhe Mushroom Farm — environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# --- Supabase (leave blank to run in local demo mode) ------------------------
# Get these from your Supabase project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin portal ------------------------------------------------------------
# Password used to sign into /admin. Choose a long random string in production.
VITE_ADMIN_PASSWORD=lakhe-admin-2026

# Optional: email(s) that get is_admin=true on Supabase profile creation.
# Comma-separated.
VITE_ADMIN_EMAILS=admin@lakhemushroomfarm.com

# --- Business info -----------------------------------------------------------
VITE_UPI_ID=lakhemushroomfarm@upi
VITE_UPI_PAYEE_NAME=Lakhe Mushroom Farm
VITE_WHATSAPP_NUMBER=919876543210
VITE_CONTACT_EMAIL=hello@lakhemushroomfarm.com
VITE_CONTACT_PHONE=+91 98765 43210
