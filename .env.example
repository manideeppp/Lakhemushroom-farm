# =============================================================================
# Lakhe Mushroom Farm — environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# --- Supabase (leave blank to run in local demo mode) ------------------------
# Get these from your Supabase project → Settings → API
# On Vercel: add the same keys under Settings → Environment Variables (Production)
# then Redeploy — Vite embeds VITE_* vars at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin portal (/admin) — password only, no email login ---------------------
# Default: lakhe-admin-2026 (must match supabase/migrations/20260814_admin_portal_rpc.sql)
VITE_ADMIN_PASSWORD=lakhe-admin-2026

# Optional legacy helper for customer account flags (not used for /admin login)
VITE_ADMIN_EMAILS=admin@lakhemushroomfarm.com

# --- Business info -----------------------------------------------------------
VITE_UPI_ID=lakhemushroomfarm@upi
VITE_UPI_PAYEE_NAME=Lakhe Mushroom Farm
VITE_WHATSAPP_NUMBER=919921480466
VITE_CONTACT_EMAIL=hello@lakhemushroomfarm.com
VITE_CONTACT_PHONE=+91 98765 43210
VITE_CONTACT_ADDRESS=Lakhe's Hi-Tech Mushroom Project, Mundhekarwadi, Maharashtra 413726
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/place/Lakhe%27s+Hi-Tech+Mushroom+Project+-+Farm/@18.5489724,74.6522284,16z/data=!4m6!3m5!1s0x3bc36a7786dfc0af:0x4737b85d5e7bfe8d!8m2!3d18.5489724!4d74.6522284!16s%2Fg%2F11gzqtn4w
VITE_GOOGLE_MAPS_EMBED=https://maps.google.com/maps?q=18.5489724,74.6522284&z=16&hl=en&output=embed
