# =============================================================================
# Lakhe Mushroom Farm — environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# --- Supabase (leave blank to run in local demo mode) ------------------------
# Get these from your Supabase project → Settings → API
# On Vercel: add the same keys under Settings → Environment Variables (Production)
# then Redeploy — Vite embeds VITE_* vars at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin portal (/admin) — password only, no email login ---------------------
# Default: lakhe-admin-2026 (must match supabase/migrations/20260814_admin_portal_rpc.sql)
VITE_ADMIN_PASSWORD=lakhe-admin-2026

# Optional legacy helper for customer account flags (not used for /admin login)
VITE_ADMIN_EMAILS=admin@lakhemushroom.com

